    {
      "parameters": {
        "jsCode": "// If a lead has no chat_id, reminders fall back to this chat. Put your own Telegram chat id here to catch those.\nconst DEFAULT_CHAT = '';\n\nconst rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\nconst terminal = ['won','lost','dead','nurture'];\nconst nowMs = $now.toMillis();\nconst out = [];\nfor (const r of rows) {\n  const status = (r.status || '').toLowerCase();\n  if (terminal.indexOf(status) !== -1) continue;\n\n  // due filter: next_followup_at <= now\n  const raw = r.next_followup_at;\n  if (!raw) continue;\n  const dueMs = new Date(raw).getTime();\n  if (isNaN(dueMs) || dueMs > nowMs) continue;\n\n  const stage = Number(r.followup_stage || 0);\n  let label, nextIso, newStatus = r.status || 'active';\n  if (stage <= 0) {\n    label = 'First follow-up — no reply yet';\n    nextIso = $now.plus({ days: 4 }).toISO();\n  } else if (stage === 1) {\n    label = 'Second follow-up — share a relevant case study';\n    nextIso = $now.plus({ days: 7 }).toISO();\n  } else {\n    label = 'Final follow-up — last touch before moving to nurture';\n    newStatus = 'nurture';\n    nextIso = $now.plus({ years: 10 }).toISO();\n  }\n\n  const chat = String(r.chat_id || DEFAULT_CHAT || '');\n  const email = r.contact_email || '';\n\n  out.push({ json: {\n    lead_id: r.lead_id,\n    contact_name: r.contact_name || '',\n    company: r.company || '',\n    domain: r.domain || '',\n    contact_email: email,\n    hasEmail: !!email,\n    notes: r.notes || '',\n    chat_id: chat,\n    hasChat: !!chat,\n    stage: stage,\n    stageLabel: label,\n    newStage: stage + 1,\n    newStatus: newStatus,\n    nextIso: nextIso,\n    lastContactedIso: $now.toISO(),\n  }});\n}\nreturn out;"
      },
      "id": "8229e942-e33c-40f1-9c90-c643acb5a397",
      "name": "Prepare Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
