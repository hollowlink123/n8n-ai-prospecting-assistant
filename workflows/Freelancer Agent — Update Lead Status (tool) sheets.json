    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst company = (r.company || '').trim();\nconst domain = (r.domain || '').trim();\nlet s = (r.status || '').toLowerCase().trim();\nlet status;\nif (/(won|signed|hired|closed|client now|deal)/.test(s)) status = 'won';\nelse if (/(lost|not interested|no|reject|declin|pass)/.test(s)) status = 'lost';\nelse if (/(dead|bounced|invalid|unreachable)/.test(s)) status = 'dead';\nelse if (/(talk|conversation|replied|responded|contacted|discuss|nurtur|hold|paus|wait)/.test(s)) status = 'nurture';\nelse if (/(new|active|open|prospect)/.test(s)) status = 'active';\nelse status = s || 'nurture';\nreturn [{ json: { company, domain, status } }];"
      },
