      "parameters": {
        "jsCode": "const ctl = $('Normalize').first().json;\nconst company = (ctl.company || '').toLowerCase().trim();\nconst domain = (ctl.domain || '').toLowerCase().replace(/^https?:\\/\\//,'').replace(/\\/$/,'').trim();\nconst rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\nlet hit = null;\nfor (const r of rows) {\n  const c = String(r.company || '').toLowerCase().trim();\n  const d = String(r.domain || '').toLowerCase().replace(/^https?:\\/\\//,'').replace(/\\/$/,'').trim();\n  if (company && c === company) { hit = r; break; }\n  if (domain && d && d === domain) { hit = r; break; }\n}\nconst target = ctl.company || ctl.domain;\nif (!hit) {\n  return [{ json: { found: false, target, status: ctl.status } }];\n}\nreturn [{ json: { found: true, lead_id: hit.lead_id, company: hit.company, target, status: ctl.status } }];"
      },
